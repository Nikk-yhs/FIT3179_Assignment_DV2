{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "autosize": {
    "type": "pad",
    "resize": true
  },
  "title": {
    "text": "When screen stories meet brick stories",
    "subtitle": [
      "Set designs released each year for three film franchises, 1999–2025; the three panels share one count scale.",
      "Red dashed lines and labels mark original theatrical film-release years. Hover for titles; click for sources."
    ],
    "anchor": "middle"
  },
  "data": {
    "url": "data/franchise_years.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "set_count": "number"
      }
    }
  },
  "facet": {
    "field": "franchise",
    "type": "nominal",
    "sort": [
      "Star Wars",
      "Harry Potter / Fantastic Beasts",
      "Jurassic Park / World"
    ],
    "header": {
      "title": null,
      "labelFontSize": 15,
      "labelFontWeight": "bold",
      "labelLimit": 500
    }
  },
  "columns": 1,
  "spacing": 30,
  "spec": {
    "width": 900,
    "height": 170,
    "encoding": {
      "x": {
        "field": "year",
        "type": "ordinal",
        "sort": "ascending",
        "title": "Release year",
        "axis": {
          "labelAngle": -45
        }
      }
    },
    "layer": [
      {
        "mark": {
          "type": "bar",
          "color": "#2466A8",
          "size": 22
        },
        "encoding": {
          "y": {
            "field": "set_count",
            "type": "quantitative",
            "title": "Set designs released",
            "scale": {
              "zero": true
            },
            "axis": {
              "tickMinStep": 1
            }
          },
          "tooltip": [
            {
              "field": "franchise",
              "title": "Franchise"
            },
            {
              "field": "year",
              "type": "ordinal",
              "title": "Year"
            },
            {
              "field": "set_count",
              "type": "quantitative",
              "title": "Mapped set designs",
              "format": ",d"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "filter": "isValid(datum.film_code) && datum.film_code !== ''"
          }
        ],
        "mark": {
          "type": "rule",
          "color": "#C63836",
          "strokeDash": [
            3,
            3
          ],
          "strokeWidth": 1.5
        },
        "encoding": {
          "tooltip": [
            {
              "field": "film_title",
              "title": "Film"
            },
            {
              "field": "year",
              "type": "ordinal",
              "title": "Original theatrical release year"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "filter": "isValid(datum.film_code) && datum.film_code !== ''"
          }
        ],
        "mark": {
          "type": "text",
          "baseline": "bottom",
          "fontSize": 10,
          "fontWeight": "bold",
          "color": "#C63836",
          "cursor": "pointer"
        },
        "encoding": {
          "y": {
            "value": -5
          },
          "text": {
            "field": "film_code"
          },
          "href": {
            "field": "source_url",
            "type": "nominal"
          },
          "tooltip": [
            {
              "field": "film_title",
              "title": "Film"
            },
            {
              "field": "year",
              "type": "ordinal",
              "title": "Original theatrical release year"
            },
            {
              "field": "source_url",
              "title": "Source"
            }
          ]
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "x": "shared",
      "y": "shared"
    }
  },
  "config": {
    "font": "Arial",
    "axis": {
      "labelFontSize": 10,
      "titleFontSize": 12
    },
    "title": {
      "fontSize": 20,
      "subtitleFontSize": 12,
      "offset": 24
    }
  }
}