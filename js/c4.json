{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 800,
  "height": 350,

  "title": {
    "text": "How the typical build changed",
    "subtitle": [
      "Line: median pieces. Shaded band: the middle 50% of set sizes.",
      "Piece count measures size, not building difficulty."
    ],
    "anchor": "start"
  },

  "data": {
    "url": "data/piece_summary.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "n": "number",
        "n_eligible": "number",
        "n_excluded": "number",
        "median": "number",
        "q1": "number",
        "q3": "number",
        "segment": "number"
      }
    }
  },

  "params": [
    {
      "name": "pieceFamily",
      "value": "All families",
      "bind": {
        "input": "select",
        "name": "Theme family: ",
        "options": [
          "All families",
          "Town & everyday life",
          "Space",
          "Castle & fantasy",
          "Pirates",
          "Technic & engineering",
          "Creative building",
          "Preschool",
          "Buildings & display",
          "Vehicles & racing",
          "Action & adventure",
          "Licensed worlds",
          "Other"
        ]
      }
    }
  ],

  "transform": [
    {
      "filter": "datum.theme_family == pieceFamily"
    },
    {
      "filter": "datum.n > 0"
    }
  ],

  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Release year",
      "scale": {"zero": false},
      "axis": {
        "format": "d",
        "tickMinStep": 1,
        "grid": false
      }
    },
    "detail": {
      "field": "segment",
      "type": "nominal"
    },
    "order": {
      "field": "year",
      "type": "quantitative"
    }
  },

  "layer": [
    {
      "mark": {
        "type": "area",
        "color": "#2563eb",
        "opacity": 0.18
      },
      "encoding": {
        "y": {
          "field": "q1",
          "type": "quantitative",
          "title": "Pieces per set",
          "scale": {"zero": true}
        },
        "y2": {
          "field": "q3"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#2563eb",
        "strokeWidth": 2,
        "point": {
          "filled": true,
          "size": 30
        }
      },
      "encoding": {
        "y": {
          "field": "median",
          "type": "quantitative",
          "title": "Pieces per set",
          "scale": {"zero": true}
        },
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "theme_family",
            "type": "nominal",
            "title": "Theme family"
          },
          {
            "field": "median",
            "type": "quantitative",
            "title": "Median pieces",
            "format": ",.1f"
          },
          {
            "field": "q1",
            "type": "quantitative",
            "title": "25th percentile",
            "format": ",.1f"
          },
          {
            "field": "q3",
            "type": "quantitative",
            "title": "75th percentile",
            "format": ",.1f"
          },
          {
            "field": "n",
            "type": "quantitative",
            "title": "Valid piece counts",
            "format": ",d"
          },
          {
            "field": "n_excluded",
            "type": "quantitative",
            "title": "Excluded piece counts",
            "format": ",d"
          }
        ]
      }
    }
  ],

  "config": {
    "title": {
      "fontSize": 20,
      "subtitleFontSize": 12
    }
  }
}