{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 850,
  "height": 450,

  "title": {
    "text": "The world, rebuilt in LEGO"
  },

  "projection": {
    "type": "equalEarth"
  },

  "params": [
    {
      "name": "selectedContinent",
      "value": "All",

      "bind": {
        "input": "select",

        "options": [
          "All",
          "Africa",
          "Asia",
          "Europe",
          "North America",
          "Oceania"
        ],

        "name": "Show landmarks in: "
      }
    }
  ],

  "layer": [
    {
      "data": {
        "url": "data/ne_50m_admin_0_countries.topojson",

        "format": {
          "type": "topojson",
          "feature": "ne_50m_admin_0_countries"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#e5e7eb",
        "stroke": "white",
        "strokeWidth": 0.5
      }
    },

    {
      "data": {
        "url": "data/landmarks_sets.csv",

        "format": {
          "type": "csv",
          "parse": {
            "set_id": "string",
            "pieces": "number",
            "longitude": "number",
            "latitude": "number",
            "map_default": "number"
          }
        }
      },

      "transform": [
        {
          "filter": "selectedContinent === 'All' || datum.continent === selectedContinent"
        },
        {
            "filter": "datum.map_default === 1"
        }
      ],

      "mark": {
        "type": "circle",
        "color": "#2563eb",
        "opacity": 0.75,
        "stroke": "white",
        "strokeWidth": 1
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "pieces",
          "type": "quantitative",
          "title": "Pieces in selected set",

          "scale": {
            "type": "linear",
            "domain": [0, 11000],
            "range": [0, 1500]
          },

          "legend": {
            "orient": "bottom",
            "values": [1500, 3000, 10000],
            "format": ","
          }
        },

        "tooltip": [
          {
            "field": "landmark",
            "type": "nominal",
            "title": "Landmark"
          },
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "set_id",
            "type": "nominal",
            "title": "LEGO set"
          },
          {
            "field": "pieces",
            "type": "quantitative",
            "title": "Pieces",
            "format": ","
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "title": {
      "fontSize": 18,
      "subtitleFontSize": 12
    }
  }
}